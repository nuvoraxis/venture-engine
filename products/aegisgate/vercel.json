{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/openapi.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/health", "destination": "/api/edge" },
    { "source": "/openapi.json", "destination": "/api/edge" },
    { "source": "/v1/(.*)", "destination": "/api/edge" }
  ]
}
