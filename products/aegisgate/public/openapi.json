{
  "openapi": "3.1.0",
  "info": {
    "title": "AegisGate API",
    "version": "0.1.0",
    "summary": "Real-time EVM wallet AML, sanctions, mixer & EIP-1967 proxy contract risk screening API",
    "description": "Zero-dependency serverless B2B risk screening API for AI agents, Web3 payment gateways, and DeFi frontends. Screens EVM addresses on Base, Ethereum, and Arbitrum against OFAC/mixer lists and live JSON-RPC state. Supports pay-per-call settlement via x402 Base Mainnet USDC ($0.01/call) to receive-only treasury 0x703d3948cc102bf4bc0ef93ef330f56be2afd69c or verified B2B API keys.",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Current deployment origin"
    },
    {
      "url": "https://aegisgate.workers.dev",
      "description": "Cloudflare Workers edge deployment template"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Service health, pricing, and OpenAPI discovery"
    },
    {
      "name": "Screening",
      "description": "Paid EVM address AML, sanctions, and contract risk screening"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"],
        "operationId": "getHealth",
        "summary": "Health and treasury status",
        "responses": {
          "200": {
            "description": "Service is operational",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/pricing": {
      "get": {
        "tags": ["System"],
        "operationId": "getPricing",
        "summary": "x402 pay-per-call and B2B monthly USDC plans",
        "responses": {
          "200": {
            "description": "Current pricing and receive-only treasury details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PricingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["System"],
        "operationId": "getOpenApiSpec",
        "summary": "Retrieve OpenAPI 3.1.0 specification",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1.0 JSON document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/screen": {
      "get": {
        "tags": ["Screening"],
        "operationId": "screenEvmAddress",
        "summary": "Screen an EVM address for OFAC/mixer risk and contract proxy state",
        "security": [
          { "ApiKeyAuth": [] },
          { "X402PaymentTx": [] }
        ],
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "required": true,
            "description": "0x-prefixed 20-byte EVM address to screen",
            "schema": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            }
          },
          {
            "name": "chain",
            "in": "query",
            "required": false,
            "description": "Target EVM network for live RPC state lookup",
            "schema": {
              "type": "string",
              "enum": ["base", "ethereum", "arbitrum"],
              "default": "base"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Screening report and optional x402 payment receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScreenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid address, unsupported chain, or upstream RPC error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "402": {
            "description": "Payment Required (x402 Base Mainnet USDC challenge)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentRequiredResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "B2B subscription API key issued after automated KYB and sanctions verification."
      },
      "X402PaymentTx": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Payment-Tx",
        "description": "Base Mainnet USDC Transfer transaction hash (>= 10000 units / $0.01 USDC) to receive-only treasury 0x703d3948cc102bf4bc0ef93ef330f56be2afd69c."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status", "service", "version", "treasury", "chains"],
        "properties": {
          "status": { "type": "string", "const": "ok" },
          "service": { "type": "string", "const": "aegisgate" },
          "version": { "type": "string" },
          "treasury": {
            "type": "string",
            "const": "0x703d3948cc102bf4bc0ef93ef330f56be2afd69c"
          },
          "chains": {
            "type": "array",
            "items": { "type": "string", "enum": ["base", "ethereum", "arbitrum"] }
          }
        }
      },
      "PricingResponse": {
        "type": "object",
        "required": ["x402_per_call_usdc", "b2b_plans_usdc_monthly", "treasury", "network"],
        "properties": {
          "x402_per_call_usdc": { "type": "string", "const": "0.01" },
          "b2b_plans_usdc_monthly": {
            "type": "object",
            "required": ["starter", "growth", "enterprise"],
            "properties": {
              "starter": { "type": "integer", "const": 49 },
              "growth": { "type": "integer", "const": 199 },
              "enterprise": { "type": "integer", "const": 499 }
            }
          },
          "treasury": {
            "type": "string",
            "const": "0x703d3948cc102bf4bc0ef93ef330f56be2afd69c"
          },
          "network": { "type": "string", "const": "base-mainnet" },
          "openapi": { "type": "string", "const": "/openapi.json" }
        }
      },
      "RiskFlag": {
        "type": "object",
        "required": ["code", "severity", "detail"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "detail": { "type": "string" }
        }
      },
      "ScreenReport": {
        "type": "object",
        "required": [
          "address",
          "chain",
          "chainId",
          "verdict",
          "riskScore",
          "isContract",
          "bytecodeBytes",
          "isEip1967Proxy",
          "implementationAddress",
          "nonce",
          "nativeBalanceWei",
          "flags",
          "checkedAt"
        ],
        "properties": {
          "address": { "type": "string" },
          "chain": { "type": "string", "enum": ["base", "ethereum", "arbitrum"] },
          "chainId": { "type": "integer" },
          "verdict": { "type": "string", "enum": ["ALLOW", "REVIEW", "BLOCK"] },
          "riskScore": { "type": "integer", "minimum": 0, "maximum": 100 },
          "isContract": { "type": "boolean" },
          "bytecodeBytes": { "type": "integer", "minimum": 0 },
          "isEip1967Proxy": { "type": "boolean" },
          "implementationAddress": { "type": ["string", "null"] },
          "nonce": { "type": "integer", "minimum": 0 },
          "nativeBalanceWei": { "type": "string" },
          "flags": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RiskFlag" }
          },
          "checkedAt": { "type": "string", "format": "date-time" }
        }
      },
      "PaymentReceipt": {
        "type": "object",
        "required": ["ok", "txHash", "payerAddress", "transferredUnits", "payerVerdict"],
        "properties": {
          "ok": { "type": "boolean" },
          "txHash": { "type": "string" },
          "payerAddress": { "type": "string" },
          "transferredUnits": { "type": "string" },
          "payerVerdict": { "type": "string", "enum": ["ALLOW", "REVIEW", "BLOCK"] }
        }
      },
      "ScreenResponse": {
        "type": "object",
        "required": ["report", "paymentReceipt"],
        "properties": {
          "report": { "$ref": "#/components/schemas/ScreenReport" },
          "paymentReceipt": {
            "oneOf": [
              { "$ref": "#/components/schemas/PaymentReceipt" },
              { "type": "null" }
            ]
          }
        }
      },
      "X402AcceptOption": {
        "type": "object",
        "required": [
          "scheme",
          "network",
          "chainId",
          "asset",
          "symbol",
          "decimals",
          "maxAmountRequired",
          "payTo",
          "resource"
        ],
        "properties": {
          "scheme": { "type": "string", "const": "exact" },
          "network": { "type": "string", "const": "base-mainnet" },
          "chainId": { "type": "integer", "const": 8453 },
          "asset": {
            "type": "string",
            "const": "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913"
          },
          "symbol": { "type": "string", "const": "USDC" },
          "decimals": { "type": "integer", "const": 6 },
          "maxAmountRequired": { "type": "string", "const": "10000" },
          "payTo": {
            "type": "string",
            "const": "0x703d3948cc102bf4bc0ef93ef330f56be2afd69c"
          },
          "resource": { "type": "string" }
        }
      },
      "PaymentRequiredResponse": {
        "type": "object",
        "required": ["error", "protocol", "version", "accepts"],
        "properties": {
          "error": { "type": "string", "const": "Payment Required" },
          "protocol": { "type": "string", "const": "x402" },
          "version": { "type": "string", "const": "1" },
          "accepts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/X402AcceptOption" }
          },
          "paymentError": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      }
    }
  }
}
