      "id": "aegisgate",
      "name": "AegisGate — EVM AML, Sanctions & Proxy Risk API",
      "category": "security-compliance",
      "chains": ["base", "ethereum", "arbitrum"],
      "mcpTools": ["screen_evm_address"],
      "endpoints": [
