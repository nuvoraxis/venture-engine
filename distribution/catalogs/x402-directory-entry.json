      "chains": ["base", "ethereum", "arbitrum"],
      "mcpTools": ["estimate_gas", "simulate_transaction", "check_rpc_health"],
      "endpoints": [
        {
          "method": "GET",
          "path": "/v1/gas",
          "gatewayPath": "/gaspulse/v1/gas",
          "priceUsdc": "0.01",
          "maxAmountRequired": "10000",
          "description": "EIP-1559 fee tiers (slow/standard/fast/urgent), base-fee trend, and congestion telemetry."
        },
        {
          "method": "POST",
          "path": "/v1/simulate",
          "gatewayPath": "/gaspulse/v1/simulate",
          "priceUsdc": "0.01",
          "maxAmountRequired": "10000",
          "description": "Pre-flight eth_call + eth_estimateGas simulation with Solidity revert decoding, balance check, and OFAC guard."
        }
      ]
    },
    {
      "id": "auditpulse",
      "name": "AuditPulse — Smart-Contract & Pool Invariant Monitor",
      "category": "defi-risk-monitoring",
      "chains": ["base", "ethereum", "arbitrum"],
      "mcpTools": ["inspect_contract_invariants", "diff_contract_snapshots", "verify_x402_payment"],
      "endpoints": [
        {
          "method": "GET",
          "path": "/v1/inspect",
          "gatewayPath": "/auditpulse/v1/inspect",
          "priceUsdc": "0.02",
          "maxAmountRequired": "20000",
          "description": "Inspect bytecode risk signals, proxy/admin slots, ERC-20 supply/decimals, and DEX/vault reserve invariants."
        },
        {
          "method": "POST",
          "path": "/v1/diff",
          "gatewayPath": "/auditpulse/v1/diff",
          "priceUsdc": "0.01",
          "maxAmountRequired": "10000",
          "description": "Compute risk diff between two contract snapshots and format generic, Slack, or Discord webhook alerts."
        }
      ]
    }
